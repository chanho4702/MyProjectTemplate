{
  "$schema": "./config/template-config.schema.json",
  "project": {
    "name": "acme-platform",
    "basePackage": "com.acme.platform"
  },
  "runtime": {
    "java": 21,
    "springBoot": "3.5.16",
    "deploymentTarget": "kubernetes"
  },
  "capacity": {
    "targetTps": 300,
    "availabilityTarget": "99.9",
    "peakConcurrency": 500
  },
  "features": {
    "database": "postgresql",
    "readWriteSplit": true,
    "redis": true,
    "kafka": true,
    "elasticsearch": false,
    "oidc": true,
    "observability": true
  },
  "environments": ["local", "dev", "prod"]
}
